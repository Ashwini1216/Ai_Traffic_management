# Database. Leave DATABASE_URL empty to use the local SQLite file data/traffic_monitor.db
# (no setup needed). To use PostgreSQL instead, start PostgreSQL, create the trafficdb
# database and traffic_app user, then set a connection string like the example below.
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg2://traffic_app:YOUR_PASSWORD@127.0.0.1:5432/trafficdb

# Generate a long random secret for your local .env file; do not commit .env.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Bootstrap one authority account on first application startup. Change both
# placeholders before using (the password needs at least 12 characters); citizen
# registration cannot create authority roles.
AUTHORITY_USERNAME=admin
AUTHORITY_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
# Optional: an email this account can also sign in with (it can be added later).
# AUTHORITY_EMAIL=

# Google Maps Platform keys. Enable Maps JavaScript API, Places API (New), and Routes API.
# Use separate keys: restrict the browser key by website referrer and the server key by API.
# Without real keys, maps and place search use OpenStreetMap and routes are straight-line
# estimates. With a server key, the website needs the browser key too.
GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_SERVER_KEY
VITE_GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_BROWSER_KEY

# ---------- Optional settings: defaults shown, uncomment a line to change it ----------

# The dataset names six time blocks but not their hours. These IST start hours are an
# assumption used to place timestamped observations, forecasts and trips into blocks.
# TIME_BLOCK_STARTS=Midnight=0,Morning=5,Daytime=10,Noon=12,Evening=16,Night=21

# Background jobs (weather, trip re-checks, stale reports, camera sampling, zone alerts,
# data quality, retention, road registry) run inside the API process. Set 0 to run them
# only on demand from the authority console.
# SCHEDULER_ENABLED=1

# A newly trained model is used for live forecasts only if its test macro-F1 beats the
# best simple baseline by at least this margin.
# MODEL_ACCEPTANCE_MIN_GAIN=0.02

# Planned demand: passenger-car-unit weight per vehicle type, the smallest group shown in
# corridor statistics (privacy), and the planned PCU treated as a full hotspot load.
# PCU_FACTORS=two_wheeler=0.75,car=1,auto_rickshaw=1.2,cab=1,bus=2.2,truck=2.2,bicycle=0.5
# DEMAND_MIN_GROUP_TRIPS=3
# DEMAND_HOTSPOT_PCU_SCALE=50

# Planned trips are re-checked automatically within this many hours of departure, and get
# their advance notice (traffic, delay, better route or time) this many minutes before it.
# TRIP_REASSESS_HOURS=12
# TRIP_REMINDER_MINUTES=60

# Sign-in: this many wrong passwords for one account within the given minutes pause its sign-in
# until that window has passed.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15

# Place search: auto (Google with a server key, otherwise OpenStreetMap), google, openstreetmap,
# or off. OpenStreetMap's Nominatim allows light use only; set your own server for heavy use.
# PLACE_SEARCH=auto
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Map tiles for the OpenStreetMap map (used without a Google browser key).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Retention: uploaded CCTV video files, detailed (sub-hour) measurements, and other
# observations. The imported historical dataset is never deleted.
# FOOTAGE_RETENTION_DAYS=30
# DETAILED_RETENTION_DAYS=365
# OBSERVATION_RETENTION_YEARS=5

# CCTV clip and stream analysis. Higher sampling rates track fast vehicles more reliably
# but take longer; clips longer than the frame limit are analysed only in part, and the
# result says so.
# VIDEO_SAMPLE_FPS=10
# VIDEO_MAX_SAMPLED_FRAMES=1500
# Detector weights; the default models/yolov8n.pt is downloaded on the first video analysis.
# YOLO_WEIGHTS=models/yolov8n.pt

# Camera streams must be rtsp://, rtmp://, http:// or https:// addresses. Set 1 to also
# accept local video files as streams (for testing with recorded clips only).
# ALLOW_FILE_STREAMS=0

# Storage folders (default: data/ and models/ inside the project folder).
# FLOWSTATE_DATA_DIR=
# FLOWSTATE_MODELS_DIR=

# Website: the API address, only when the website is served from a different origin.
# VITE_API_BASE=

# Legacy: a fixed bearer token accepted on authority endpoints, for scripts. Leave it
# unset unless you need it; anyone who has it gets authority access.
# AUTHORITY_TOKEN=
