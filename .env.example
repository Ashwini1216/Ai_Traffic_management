# PostgreSQL is the recommended application database. Start PostgreSQL and
# create trafficdb + traffic_app first. Local SQLite remains the fallback when
# DATABASE_URL is empty.
DATABASE_URL=postgresql+psycopg2://traffic_app:CHANGE_ME@127.0.0.1:5432/trafficdb

# Generate a long random secret for your local .env file; do not commit .env.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Bootstrap one authority account on first application startup. Change both
# placeholders before using; citizen registration cannot create authority roles.
AUTHORITY_USERNAME=admin
AUTHORITY_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD

# Optional provider overrides
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=BengaluruTrafficMonitor/1.0 (educational local project)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
